# Copy this file to .env and fill in real values. Never commit .env.

# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# Which config class to load: development | testing | production
FLASK_CONFIG=development

# Defaults to a local SQLite file if unset. For production use Postgres,
# e.g. postgresql://user:password@host:5432/jobhunter
DATABASE_URL=sqlite:///instance/jobhunter.db

